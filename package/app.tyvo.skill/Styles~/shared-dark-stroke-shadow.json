{
  "id": "shared-dark-stroke-shadow",
  "name": "Shared Dark Stroke + Shadow",
  "track": "shared",
  "description": "Shared Dark Stroke plus a soft black drop shadow at partial alpha. Same reuse rules as shared-dark-stroke.",
  "padding": 10,
  "shared": { "strokeAlpha": 45, "testBackgrounds": ["#8E8E93", "#3DBE4E", "#2F80ED", "#F2C94C", "#EB5757", "#9B51E0"] },
  "layers": [
    {
      "name": "Body",
      "effects": [
        { "type": "colorOverlay", "color": "#FFFFFF", "opacity": 100 },
        { "type": "stroke", "position": "outside", "size": 4, "color": "#000000", "opacity": 45 },
        { "type": "dropShadow", "color": "#000000", "opacity": 35, "blend": "normal", "angle": 90, "distance": 3, "spread": 0, "size": 2 }
      ]
    }
  ]
}
